# Copy to backend/.env. Everything is optional: with nothing set, the server runs the in-memory demo workspace.

# AI providers. Without keys the LLM steps run as labelled heuristics.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Persistence (Postgres / AlloyDB). Unset = in memory, reset on restart.
# HINDSIGHT_DATABASE_URL=postgresql://user:password@localhost:5432/lit_scout

# Comma-separated allowed origins (default: *)
# CORS_ORIGINS=https://resaidserch.vercel.app

# Where GET / redirects (the frontend)
# FRONTEND_URL=http://localhost:5173

# Seconds each demo research step takes
# DEMO_STEP_SECONDS=1.6
