# Database
# For Cloud Run + AlloyDB: postgresql://username:password@/lit_scout?host=/cloudsql/PROJECT:REGION:INSTANCE
# For local dev with Cloud SQL Proxy: postgresql://user:password@localhost:5432/lit_scout
# For local Docker: postgresql://postgres:password@db:5432/lit_scout
DATABASE_URL=postgresql://user:password@localhost:5432/lit_scout

# AI Providers
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk-...

# Google Cloud
GCS_BUCKET=lit-scout-pdfs
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials.json

# Server
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# JWT
JWT_SECRET=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# CORS (for production, update with actual Vercel domain)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://YOUR_VERCEL_DOMAIN.vercel.app

# Sentry
SENTRY_DSN=https://...@sentry.io/...
